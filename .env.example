# Copy this file to .env and fill in your own values.
# Never commit a populated .env — it is git-ignored.

# Broker credentials (GOAT_* variable names)
GOAT_EMAIL=
GOAT_PASSWORD=
GOAT_SERVER=
GOAT_ACCOUNT_ID=
GOAT_ACC_NUM=
GOAT_ACCESS_TOKEN=
GOAT_REFRESH_TOKEN=
GOAT_LIVE=false

# Dashboard password (leave empty to disable dashboard login)
DASHBOARD_PASSWORD=

# Optional recovery email via SMTP (leave blank to log reset codes locally)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_APP_PASSWORD=
RECOVERY_EMAIL=
